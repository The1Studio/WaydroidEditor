      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/WaydroidPrefsEditor.Core/WaydroidPrefsEditor.Core.csproj" />
    <ProjectReference Include="../../src/WaydroidPrefsEditor.App/WaydroidPrefsEditor.App.csproj" />
    <ProjectReference Include="../FakeGameData/FakeGameData.csproj" />
  </ItemGroup>
